{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "rootDir": "./src",      // <--- Adicione esta linha exatamente assim
    "outDir": "./dist",      // É boa prática definir para onde o código compilado vai
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/**/*"],    // Garante que ele olhe tudo dentro de src
  "exclude": ["node_modules"]
}